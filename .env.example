# SINAPSIS — variables de entorno (todas opcionales)
# Copia este archivo a .env.local. Sin ninguna clave la aplicación funciona completa:
# el Analista IA responde en "modo directo" con las mismas herramientas, sin modelo de lenguaje.

# Activa el chat con Gemini en el Analista IA. Crear en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo de Gemini para el Analista (alternativa: gemini-2.5-flash-lite)
ANALISTA_MODELO=gemini-2.5-flash
