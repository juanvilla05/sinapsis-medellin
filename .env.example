# PULSO — variables de entorno (todas opcionales)
# Copia este archivo a .env.local. Sin ninguna clave la aplicación funciona completa:
# el Analista IA responde en "modo directo" con las mismas herramientas, sin modelo de lenguaje.

# Activa el chat con Gemini en el Analista IA. Crear en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo de Gemini para el Analista (alternativa: gemini-2.5-flash-lite)
ANALISTA_MODELO=gemini-2.5-flash

# Rutas inteligentes (opcional). Sin estas claves el mapa y los datos funcionan; el planificador avisa que no está disponible.
# Google Routes API (computeRoutes) — solo servidor
GOOGLE_ROUTES_API_KEY=
# Google Places API (New) para autocompletar direcciones — solo servidor
GOOGLE_PLACES_API_KEY=

# Voz humana de PulsoBot (opcional). Sin clave, PulsoBot usa la voz del navegador.
ELEVENLABS_API_KEY=
# Voz y modelo (opcionales). Las voces de la biblioteca de ElevenLabs (p. ej. una colombiana) requieren plan de pago.
ELEVENLABS_VOZ_ID=
ELEVENLABS_MODELO=eleven_turbo_v2_5
